# Security
JWT_SECRET=your_super_secret_key_minimum_32_chars_change_in_production
NODE_ENV=development
LOG_LEVEL=info
TLS_KEY_PATH=/etc/ssl/private/contaore.key
TLS_CERT_PATH=/etc/ssl/certs/contaore.crt

# Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_KEY=your_public_key

# Email
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=noreply@contaore.app

# 2FA/SMS
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=+1234567890

# Server
PORT=3000
FRONTEND_URL=https://contaore-eight.vercel.app
